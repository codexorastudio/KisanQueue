# ==============================================================================
# KisanQueue - Environment Configuration Template
# Copy this file to .env and replace placeholder values with your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini AI (Multilingual Kisan AI Assistant & Crop Advisory)
# Obtain from: https://aistudio.google.com/app/apikey
# Note: Either GEMINI_API_KEY or VITE_GEMINI_API_KEY can be used.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. Sarvam AI (Native Malayalam IVR & Voice Synthesis)
# Obtain from: https://www.sarvam.ai/
# ------------------------------------------------------------------------------
SARVAM_API_KEY=your_sarvam_api_key_here

# ------------------------------------------------------------------------------
# 3. Supabase Project Configuration (PostgreSQL Database, Auth & Realtime)
# Obtain from: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
# Project URL (e.g. https://yourprojectid.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Public Anon Key (safe for browser client-side operations)
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Supabase Service Role Key (secret key for server/admin tasks & migrations)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
